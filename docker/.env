# =============================================================================
# phis4 Docker Node — Non-Sensitive Configuration
# Safe to commit. Secrets live in services/**/.secrets.env (gitignored, host-only).
# =============================================================================

# --- Host ---
TZ=America/Denver
PUID=1000
PGID=1000

# --- Storage ---
# mergerfs is retired (2026-09-05). /mnt/phis4/hot is ssd1, bind-mounted.
# The media drive becomes a nested mount at /mnt/phis4/hot/media once media
# is restored onto it. These paths are deliberately unchanged from the
# mergerfs era, so no container, *arr root folder, Jellyfin library, or
# Nextcloud datadir ever had to be repointed.
# Libraries live directly under DATA_DIR (movies/, shows/, music/), alongside
# torrents/, usenet/, photos/, books/ - one filesystem, so *arr imports stay
# hardlinked and atomic.
CONFIG_DIR=/mnt/phis4/hot/config
DATA_DIR=/mnt/phis4/hot/media

# --- Network ---
LOCAL_SUBNET=192.168.1.0/24
VPN_SERVER_COUNTRIES="United States"
VPN_SERVER_CITIES="Seattle"

# --- Jellyfin ---
JELLYFIN_URI=http://media.perihelion.live
# JELLYFIN_URL is what jellysignal uses to reach Jellyfin — must be the host
# IP, not localhost (separate container network namespaces).
JELLYFIN_URL=http://192.168.1.215:8096
# Host-specific GIDs (getent group render video) — 993/44 on phis4.
JELLYFIN_RENDER_GROUP=993
JELLYFIN_VIDEO_GROUP=44

# --- Ports ---
QBIT_WEBUI_PORT=8085
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
LIDARR_PORT=8686
BAZARR_PORT=6767
BOOKSHELF_PORT=8787
READARR_PORT=8787
LAZYLIBRARIAN_PORT=5299
JELLYSEERR_PORT=5055
CLEANUPARR_PORT=11011
SABNZBD_PORT=8090
IMMICH_PORT=2283
CADENCE_PORT=3000
SINK_PORT=6720
VAULTWARDEN_PORT=8222

# --- Immich ---
IMMICH_VERSION=v3.1.0
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich

# --- Odysseus ---
# Upstream publishes only dev tags (1.0.0-dev.<sha>): ghcr.io/pewdiepie-archdaemon/odysseus
ODYSSEUS_VERSION=1.0.0-dev.1602674
ODYSSEUS_PORT=7000
ODYSSEUS_ADMIN_USER=admin
NTFY_PORT=8091
# Reachable URL for the bundled ntfy, used in its notifications/links.
NTFY_BASE_URL=http://192.168.1.215:8091
