# Watchtower secrets. Copy to .secrets.env and fill in (workflow: README.md).
# .secrets.env is gitignored - never commit real values.

# Discord webhook for #epoch, in shoutrrr form. Take the webhook URL
#   https://discord.com/api/webhooks/<ID>/<TOKEN>
# and write it as discord://<TOKEN>@<ID> (token first, id second).
WATCHTOWER_NOTIFICATION_URL=discord://REPLACE_TOKEN@REPLACE_ID
