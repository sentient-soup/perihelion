# Ingest secrets. Copy to .secrets.env and fill in (workflow: README.md).
# .secrets.env is gitignored — never commit real values.

# ProtonVPN WireGuard private key
# Generate at: https://account.proton.me/u/0/vpn/WireGuard
PROTON_WIREGUARD_PRIVATE_KEY=REPLACE_ME

# MyAnonamouse session cookie (mam_id value from browser DevTools > Application > Cookies)
MAM_SESSION_ID=REPLACE_ME

# qBittorrent WebUI password — read by bootstrap/sync-qbit-port.sh to update the
# forwarded listen port. Must match the qBittorrent WebUI login. QBIT_USER
# defaults to "admin"; uncomment to override.
QBIT_PASS=REPLACE_ME
# QBIT_USER=admin
