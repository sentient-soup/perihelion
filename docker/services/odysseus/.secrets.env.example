# Odysseus secrets. Copy to .secrets.env and fill in (workflow: README.md).
# .secrets.env is gitignored — never commit real values. All optional; leave
# a key out (or blank) to skip that integration.

# First admin password, pre-seeded on first boot. Set before starting, or
# create the admin via the setup UI instead.
ODYSSEUS_ADMIN_PASSWORD=REPLACE_ME

# Pins the secret searxng signs cookies/CSRF with (else generated on first
# boot and stored in the searxng config dir). Any long random string.
# SEARXNG_SECRET=REPLACE_ME

# Model provider credentials (only what you use)
# OPENAI_API_KEY=
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Web-search provider keys (SearXNG is bundled and needs none of these)
# DATA_BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
