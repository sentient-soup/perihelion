# Copy to k8s/.env and fill in real values. k8s/.env is git-ignored — never commit it.
# Consumed by k8s/scripts/generate-secret.sh to produce SealedSecret manifests.

# Cloudflare API token (scoped: Zone > DNS > Edit + Zone > Read on perihelion.live).
# Used by cert-manager's DNS-01 solver. Token strings start with "cfat_".
CLOUDFLARE_API_TOKEN=

# Pihole web admin password.
PIHOLE_PASSWORD=

# Traefik dashboard basic-auth credentials (hashed into an htpasswd secret).
TRAEFIK_DASHBOARD_USER=
TRAEFIK_DASHBOARD_PASSWORD=

# VictoriaMetrics remote-write basic-auth (metrics.perihelion.live/api/v1/write).
# The clients pushing metrics must use these same credentials.
VICTORIAMETRICS_USER=
VICTORIAMETRICS_PASSWORD=

# Apseline HUD secrets (sealed into apseline-secrets in the `apps` namespace).
# Session signing key — any long random string (e.g. `openssl rand -hex 32`).
APSELINE_SESSION_SECRET=
# OAuth client secret — leave empty unless OAUTH_ENABLED=true in apseline-config.
APSELINE_OAUTH_CLIENT_SECRET=
# Apseline reuses CLOUDFLARE_API_TOKEN above for its Cloudflare discovery.
